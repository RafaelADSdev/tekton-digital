<div
  class="comparison"
  data-comparison
  data-device="desktop"
  data-comparison-edge="middle"
  style="--comparison-position: 50%"
>
  <div class="case-viewer-toolbar">
    <div class="device-toggle" role="group" aria-label="Escolher visualização do case">
      <button type="button" data-device-button="desktop" aria-pressed="true">
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <rect x="2.5" y="3" width="15" height="10.5" rx="1"></rect>
          <path d="M7 17h6M10 13.5V17"></path>
        </svg>
        Desktop
      </button>
      <button type="button" data-device-button="mobile" aria-pressed="false">
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <rect x="5.5" y="2" width="9" height="16" rx="1.5"></rect>
          <path d="M9 15.5h2"></path>
        </svg>
        Mobile
      </button>
    </div>
    <p class="viewer-source">
      <span data-device-status>Capturas desktop · 1440 × 900</span>
      <small>Sites públicos · 04 set. 2026</small>
    </p>
  </div>

  <div class="comparison-viewport">
    <div
      class="comparison-stage"
      tabindex="0"
      role="slider"
      aria-label="Comparar versão anterior e redesign. Arraste ou use as setas do teclado."
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="50"
    >
      <article class="site-proof proof-after" aria-label="Redesign do site da Náutica Engenharia">
        <div class="browser-bar"><i></i><i></i><i></i></div>
        <div class="capture-frame">
          <img
            class="capture-image capture-desktop"
            src="/assets/cases/nautica-after-desktop.jpg"
            alt="Redesign da página inicial da Náutica Engenharia no desktop, com navegação compacta, título forte e ações comerciais claras"
            width="1440"
            height="900"
            loading="lazy"
            decoding="async"
            draggable="false"
          />
          <img
            class="capture-image capture-mobile"
            src="/assets/cases/nautica-after-mobile.jpg"
            alt="Redesign da página inicial da Náutica Engenharia no celular, com título legível, posicionamento regional e dois botões de ação"
            width="390"
            height="844"
            loading="lazy"
            decoding="async"
            draggable="false"
          />
        </div>
      </article>

      <div class="comparison-before-clip">
        <article class="site-proof proof-before" aria-label="Versão anterior do site da Náutica Engenharia">
          <div class="browser-bar"><i></i><i></i><i></i></div>
          <div class="capture-frame">
            <img
              class="capture-image capture-desktop"
              src="/assets/cases/nautica-before-desktop.jpg"
              alt="Página inicial anterior da Náutica Engenharia no desktop, com menu extenso, fotografia de obra e grande logotipo central"
              width="1440"
              height="900"
              loading="lazy"
              decoding="async"
              draggable="false"
            />
            <img
              class="capture-image capture-mobile"
              src="/assets/cases/nautica-before-mobile.jpg"
              alt="Página inicial anterior da Náutica Engenharia no celular, com hero seguido imediatamente por uma grade carregada de serviços"
              width="390"
              height="844"
              loading="lazy"
              decoding="async"
              draggable="false"
            />
          </div>
        </article>
      </div>

      <div class="comparison-line" aria-hidden="true">
        <span class="comparison-handle">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14 8l-4 4 4 4" />
          </svg>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M10 8l4 4-4 4" />
          </svg>
        </span>
      </div>
    </div>
  </div>
</div>

<script>
  const comparisons = document.querySelectorAll<HTMLElement>('[data-comparison]');

  comparisons.forEach((comparison) => {
    const stage = comparison.querySelector<HTMLElement>('.comparison-stage');
    const status = comparison.querySelector<HTMLElement>('[data-device-status]');
    const deviceButtons = comparison.querySelectorAll<HTMLButtonElement>('[data-device-button]');
    let activePointer: number | null = null;

    const setPosition = (position: number) => {
      const pct = Math.round(Math.min(100, Math.max(0, position)));
      comparison.style.setProperty('--comparison-position', `${pct}%`);
      comparison.dataset.comparisonEdge = pct <= 2 ? 'start' : pct >= 98 ? 'end' : 'middle';
      stage?.setAttribute('aria-valuenow', String(pct));
      stage?.setAttribute(
        'aria-valuetext',
        pct <= 2 ? 'Somente redesign' : pct >= 98 ? 'Somente versão anterior' : `Divisor em ${pct}%`,
      );
    };

    const setPositionFromPointer = (event: PointerEvent) => {
      if (!stage) return;
      const bounds = stage.getBoundingClientRect();
      if (bounds.width === 0) return;
      setPosition(((event.clientX - bounds.left) / bounds.width) * 100);
    };

    const setDevice = (device: 'desktop' | 'mobile') => {
      comparison.dataset.device = device;
      deviceButtons.forEach((item) => item.setAttribute('aria-pressed', String(item.dataset.deviceButton === device)));
      if (status) status.textContent = device === 'desktop' ? 'Capturas desktop · 1440 × 900' : 'Capturas mobile · 390 × 844';
    };

    stage?.addEventListener('keydown', (event) => {
      const current = Number(stage.getAttribute('aria-valuenow') ?? 50);
      if (event.key === 'ArrowLeft' || event.key === 'ArrowDown') {
        event.preventDefault();
        setPosition(current - (event.shiftKey ? 10 : 2));
      } else if (event.key === 'ArrowRight' || event.key === 'ArrowUp') {
        event.preventDefault();
        setPosition(current + (event.shiftKey ? 10 : 2));
      } else if (event.key === 'Home') {
        event.preventDefault();
        setPosition(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        setPosition(100);
      }
    });

    stage?.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      activePointer = event.pointerId;
      stage.setPointerCapture(event.pointerId);
      stage.dataset.dragging = 'true';
      setPositionFromPointer(event);
    });

    stage?.addEventListener('pointermove', (event) => {
      if (activePointer !== event.pointerId) return;
      setPositionFromPointer(event);
    });

    const finishPointer = (event: PointerEvent) => {
      if (activePointer !== event.pointerId) return;
      setPositionFromPointer(event);
      activePointer = null;
      delete stage?.dataset.dragging;
      if (stage?.hasPointerCapture(event.pointerId)) stage.releasePointerCapture(event.pointerId);
    };

    stage?.addEventListener('pointerup', finishPointer);
    stage?.addEventListener('pointercancel', finishPointer);

    deviceButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const device = button.dataset.deviceButton;
        if (device !== 'desktop' && device !== 'mobile') return;
        setDevice(device);
      });
    });

    setPosition(50);
    if (window.matchMedia('(max-width: 760px)').matches) setDevice('mobile');
  });
</script>
