# Endereço público final, sem barra no fim
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Somente dígitos, incluindo país e DDD. Ex.: 5581999999999
# Em branco, o site usa o número padrão definido em src/data/site.ts.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Credenciais exclusivas do servidor. Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Compatibilidade com projetos Supabase antigos. Prefira SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
